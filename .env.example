# =====================================================================
# HRMS — قالب متغيرات البيئة (Environment Variables)
#   cp .env.example .env   ثم عدّل كل قيمة CHANGE_ME
#
# ⚠️ قواعد أمان إلزامية:
#   - ملف .env الحقيقي لا يُرفع إلى Git إطلاقًا (انظر .gitignore).
#   - استبدل كل CHANGE_ME قبل التشغيل في الإنتاج.
#   - لا تشارك SECRET_KEY أو كلمات المرور مع أي شخص.
# =====================================================================

# ---------------------------------------------------------------------
# Django — عام (تطوير وإنتاج)
# ---------------------------------------------------------------------
# مفتاح سري للتوقيع والتشفير — ولّده مرة واحدة:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=CHANGE_ME_generate_a_long_random_secret_key

# True = وضع التطوير (أخطاء مفصلة) | False = إنتاج (بفرض استخدام config.settings.prod)
DJANGO_DEBUG=True

DJANGO_LANGUAGE_CODE=ar
DJANGO_TIME_ZONE=Africa/Algiers

# ---------------------------------------------------------------------
# Hosts (النطاقات المسموح الوصول منها)
# ---------------------------------------------------------------------
# قائمة مفصولة بفواصل. التطوير:
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# الإنتاج — عناوين LAN الفعلية:
# DJANGO_ALLOWED_HOSTS=192.168.1.10,hrms.local

# ---------------------------------------------------------------------
# قاعدة البيانات
# ---------------------------------------------------------------------
# التطوير: اترك متغيرات DB فارغة/معلّقة → يستخدم SQLite (db.sqlite3) تلقائيًا.
#
# الإنتاج — PostgreSQL (config.settings.prod):
DJANGO_DB_NAME=hrms
DJANGO_DB_USER=hrms
DJANGO_DB_PASSWORD=CHANGE_ME_strong_database_password
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=5432

# ---------------------------------------------------------------------
# مشرف التهيئة — أمر seed_all
# ---------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_strong_unique_admin_password
ADMIN_EMAIL=admin@hrms.local
